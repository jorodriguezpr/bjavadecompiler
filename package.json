{
  "name": "bjavadecompiler",
  "version": "1.9.0",
  "description": "BJavaDecompiler - decompiles Java WAR/JAR files into recompilable NetBeans Maven projects, using CFR + Vineflower + jd-cli + JADX + Procyon plus a choice of AI provider (Ollama Cloud, local Ollama, OpenAI, Anthropic, or Claude Code via AiWindowsAssistant delegation) to fill the gaps",
  "author": "Jose Rodriguez <jrpcone@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jorodriguezpr/bjavadecompiler"
  },
  "homepage": "https://github.com/jorodriguezpr/bjavadecompiler",
  "bugs": {
    "url": "https://github.com/jorodriguezpr/bjavadecompiler/issues"
  },
  "main": "dist/index.js",
  "bin": {
    "bjavadecompiler": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "cli": "ts-node src/cli.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest --forceExit",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.7.7",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "java-parser": "^3.0.1",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0",
    "winston": "^3.14.0",
    "yazl": "^2.5.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.0",
    "@types/uuid": "^10.0.0",
    "@types/yazl": "^2.4.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}

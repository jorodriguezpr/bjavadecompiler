# Server
PORT=7795
NODE_ENV=development

# AI provider (AI reconstruction/remediation pass) — one of:
#   ollama-cloud   (default) — hosted Ollama Cloud, needs OLLAMA_CLOUD_API_KEY
#   ollama-local   — a local `ollama serve`, no API key
#   lm-studio      — LM Studio's built-in local server (Developer tab -> Start Server), no API
#                    key. Speaks the same OpenAI-shaped Chat Completions API as `openai` below.
#   openai         — OpenAI's Chat Completions API, needs OPENAI_API_KEY
#   anthropic      — Anthropic's Messages API directly, needs ANTHROPIC_API_KEY. Different from
#                    ai-delegation below: this talks straight to Anthropic's API with your own
#                    key, no AiWindowsAssistant or desktop Claude Code CLI involved at all.
#   ai-delegation  — hands the prompt to a local AiWindowsAssistant instance, which runs it
#                    through your own authenticated Claude Code CLI and posts the result back.
#                    No API key here at all; see "AI delegation" below.
AI_PROVIDER=ollama-cloud

# Ollama Cloud — used when AI_PROVIDER=ollama-cloud (or unset)
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_HOST=https://ollama.com

# Local Ollama — used when AI_PROVIDER=ollama-local. No API key needed; just run
# `ollama serve` and `ollama pull qwen2.5-coder:7b` (or any other model) first.
OLLAMA_LOCAL_HOST=http://localhost:11434

# LM Studio — used when AI_PROVIDER=lm-studio. No API key needed; open LM Studio, load a model,
# and start the server from the Developer tab (default port 1234) first. LM Studio's default
# single-model server mode serves whatever's currently loaded regardless of AI_MODEL below.
LM_STUDIO_HOST=http://localhost:1234

# OpenAI — used when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_HOST=https://api.openai.com

# Anthropic — used when AI_PROVIDER=anthropic. max_tokens is required on every Messages API
# request (no server-side default the way OpenAI/Ollama have) — 8192 is high enough that a full
# class reconstruction isn't truncated mid-file.
ANTHROPIC_API_KEY=
ANTHROPIC_HOST=https://api.anthropic.com
ANTHROPIC_MAX_TOKENS=8192

# Model name — defaults to glm-5.2 (ollama-cloud), qwen2.5-coder:7b (ollama-local),
# gpt-4o-mini (openai), or claude-sonnet-5 (anthropic). Set explicitly to override any of them,
# e.g. deepseek-coder-v2:16b for a different local pull, gpt-4o for OpenAI, or
# claude-opus-5/claude-haiku-4-5 for a different Claude tier. Ignored by ai-delegation — Claude
# Code uses whichever model it's already configured with on the desktop running AiWindowsAssistant.
# For lm-studio, only matters if you're running LM Studio's newer multi-model server mode — its
# default single-model mode serves whatever's loaded regardless of this value.
AI_MODEL=

# AI delegation — used when AI_PROVIDER=ai-delegation. AI_DELEGATION_WORKER_API_KEY is
# auto-generated on first request (Tool Setup page → AI Delegation worker setup → Reveal/Copy);
# nothing to set here manually. How long to wait for AiWindowsAssistant to claim and finish a
# delegated prompt before giving up (ms) — generous by default since it depends on a desktop
# actually being awake and a real Claude Code turn completing.
AI_DELEGATION_TIMEOUT_MS=900000

# Pipeline tuning
MAX_UPLOAD_MB=200
MAX_BUILD_FIX_ATTEMPTS=5
AI_CONCURRENCY=3
DECOMPILER_TIMEOUT_MS=600000

# Speed/feature toggles — a WAR with many bundled third-party jars can take hours once a slow
# local model is doing the AI passes; these let you trade completeness for speed.
AI_ENABLED=true
DECOMPILE_ENGINES=
DECOMPILE_UNRESOLVED_LIBS=true
DECOMPILE_PARALLEL=false
AUTO_MATCH_UNRESOLVED_DEPS=true

# Local jar folder(s) searched when a bundled WEB-INF/lib jar can't be matched to a real Maven
# Central coordinate (pom.properties/SHA-1/filename-guess/class-vote all fail) — for internal or
# proprietary jars (other modules of the same in-house product, vendor jars from a private repo)
# that will never show up in a public Central search no matter how good the heuristic. An exact
# SHA-1 byte match against a jar in this folder gives the dependency a real, meaningful
# groupId/artifactId/version (from the shared copy's own embedded pom.properties, or its
# filename) instead of the generic com.bjavadecompiler.unresolved placeholder — it still gets
# installed locally from the WAR's own original jar bytes and decompiled exactly like any other
# unresolved dependency, this only improves its identity/naming. One or more directories,
# separated by ; or , (scanned recursively). Leave empty to disable.
SHARED_DEPENDENCIES_DIRS=

# Additional local folder(s), searched ONLY when a class is missing from the WAR entirely
# (`mvn compile` reports "package X does not exist" — no jar to match at all, not even a wrong
# one) rather than for jars already bundled in WEB-INF/lib. Accepts TWO kinds of content, both at
# once: (a) .jar files anywhere under the folder (combined with SHARED_DEPENDENCIES_DIRS above when
# building the jar-based index, so you don't have to duplicate a folder listed there), and (b) a
# "permanent library" of already-decompiled source — each immediate SUBDIRECTORY of this folder is
# treated as one decompiled module, exactly like a job's own decompiled-libs/<artifactId>/ (same
# package-matching directory layout expected). Handy for hand-copying decompiled-libs/ output out
# of prior jobs so it stays searchable even after that job's workspace is gone, without needing
# SEARCH_WORKSPACE_DECOMPILED_LIBS below at all. Same ; or , separator for multiple folders. Leave
# empty to only use SHARED_DEPENDENCIES_DIRS for this search.
MISSING_PACKAGES_SEARCH_DIR=

# When true, missing-package search ALSO looks across every other job's already-decompiled
# dependency source under data/workspaces/<jobId>/decompiled-libs/<artifactId>/ — useful when
# several WARs from the same product suite share internal modules: a class missing from THIS WAR
# may already have been decompiled (and AI-cleaned) as an unresolved dependency of a different
# job run earlier. Tried only after both jar folders above come up empty for a given package. Off
# by default — scanning every prior job's decompiled output on every build-fix attempt is real,
# avoidable work if you're not running related WARs through this app.
SEARCH_WORKSPACE_DECOMPILED_LIBS=false

# Last-resort, opt-in remediation for a missing package that genuinely has no jar or previously-
# decompiled library anywhere (e.g. com.sun.jdmk.comm — a Sun JVM extension with no redistributable
# Maven artifact under any coordinate; a real dependency simply doesn't exist to find). When true,
# a decompiled dependency's own source file that references such a package AND is referenced by
# nothing else anywhere in the project gets moved (never deleted — relocated to this job's
# workspace excluded-unfixable-classes/ folder) out of the compiled path, instead of leaving the
# build permanently broken by dead optional code (confirmed real case: log4j's own bundled, never-
# instantiated JMSAppender/JMX Agent classes). Off by default — meaningfully more aggressive than
# every other toggle here, since it removes source from the compiled output rather than just
# adding/excluding a dependency.
PRUNE_UNFIXABLE_DECOMPILED_CLASSES=false

# Folder(s) containing a real Java EE/Jakarta EE container installation's own runtime libraries —
# e.g. $GLASSFISH_HOME/glassfish/lib and $GLASSFISH_HOME/glassfish/modules for GlassFish, or the
# WildFly/WebSphere/Payara equivalent. A WAR never bundles these (the container supplies
# javax.mail/javax.ejb/javax.transaction/CDI/JAX-RS/etc. at runtime) so decompiling one on its own
# shows "package X does not exist" with no jar anywhere to explain it. Only consulted for packages
# the app's own built-in provided-API catalog doesn't already cover (a vendor extension, an
# older/newer spec version) — a match is installed locally and added scope=provided, but never
# decompiled (it's the server's code, not the WAR's). Same ; or , separator. Leave empty to skip.
JAVAEE_PROVIDED_LIBS_DIR=

# Java release every generated project compiles against when a job doesn't request its own (see
# the per-upload Target Java Version selector). 'auto' keeps the existing bytecode-detected-and-
# clamped-to-8 behavior; set to 8/11/17/21 etc. to always override detection, e.g. because most of
# what you feed this app targets Java 8 even though you run NetBeans on JDK 17.
DEFAULT_TARGET_JAVA_VERSION=auto

# Maps a Java release to a real local JDK installation, so a job targeting that release actually
# compiles with THAT JDK's own javac (JAVA_HOME/PATH override on the mvn subprocess) instead of
# whichever single JDK satisfies this app's own toolchain floor. Format: version=path pairs
# separated by ; or , — e.g. 8=C:\Program Files\Java\jdk1.8.0_202;11=C:\Program Files\Java\jdk-11
# A version with no entry here just runs mvn on whatever JDK is already on PATH, same as before
# this setting existed. Leave empty to always use the JDK already on PATH.
JDK_HOME_OVERRIDES=
